{
  "name": "enrichment-switcher-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate:harmonies && next build",
    "start": "next start",
    "lint": "next lint",
    "generate:harmonies": "npx tsx scripts/generate-harmony-bundle.ts",
    "verify:harmonies": "npx tsx scripts/verify-harmony-bundle.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:preflight": "npx tsx tests/arrangements-v2-preflight.test.ts",
    "test:preflight:headful": "HEADLESS=false npx tsx tests/arrangements-v2-preflight.test.ts",
    "test:waterfall": "npx tsx tests/waterfall-builder.test.ts",
    "test:waterfall:headful": "HEADLESS=false npx tsx tests/waterfall-builder.test.ts",
    "test:delete-harmony": "npx tsx tests/e2e/delete-harmony.spec.ts",
    "test:delete-harmony:headful": "HEADLESS=false npx tsx tests/e2e/delete-harmony.spec.ts",
    "test:taxonomy-read-field": "npx tsx tests/e2e/taxonomy-read-field.spec.ts",
    "test:taxonomy-read-field:headful": "HEADLESS=false npx tsx tests/e2e/taxonomy-read-field.spec.ts",
    "test:visual": "HEADLESS=false npx tsx tests/visual-inspection.ts",
    "worker:webhooks": "npx tsx scripts/start-webhook-worker.ts",
    "worker:digest": "npx tsx scripts/start-digest-worker.ts",
    "worker:arrangement": "npx tsx scripts/start-arrangement-worker.ts",
    "worker:enrichment": "npx tsx scripts/start-enrichment-worker.ts",
    "worker:dedup": "npx tsx scripts/start-dedup-worker.ts",
    "worker:import": "npx tsx scripts/start-import-worker.ts",
    "worker:normalize": "npx tsx scripts/start-normalize-worker.ts",
    "worker:jobs": "npx tsx scripts/start-job-segmentation-worker.ts",
    "worker:harmony-scan": "npx tsx scripts/start-harmony-scan-worker.ts",
    "worker:record-count": "npx tsx scripts/start-record-count-worker.ts",
    "cleanup:cache": "npx tsx scripts/cleanup-cache.ts",
    "dummy:create": "npx tsx --env-file=.env.local scripts/create-dummy-companies.ts",
    "dummy:delete": "npx tsx --env-file=.env.local scripts/delete-dummy-companies.ts",
    "dummy:benchmark": "npx tsx --env-file=.env.local scripts/run-normalize-benchmark.ts",
    "dummy:benchmark:direct": "npx tsx --env-file=.env.local scripts/run-normalize-benchmark-direct.ts",
    "jobs:test": "npx tsx --env-file=.env.local scripts/test-job-classifier.ts",
    "jobs:segment": "npx tsx --env-file=.env.local scripts/test-job-segmentation.ts",
    "jobs:segment:live": "npx tsx --env-file=.env.local scripts/test-job-segmentation-live.ts",
    "jobs:custom-fields": "npx tsx --env-file=.env.local scripts/test-custom-field-mapping.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.0",
    "@clerk/nextjs": "^5.7.6",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/nextjs": "^10.53.1",
    "@sentry/node": "^10.53.1",
    "@supabase/supabase-js": "^2.105.4",
    "@tiptap/extension-code-block-lowlight": "^3.26.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/extension-table-cell": "^3.26.0",
    "@tiptap/extension-table-header": "^3.26.0",
    "@tiptap/extension-table-row": "^3.26.0",
    "@tiptap/extension-youtube": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@types/papaparse": "^5.5.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.34.3",
    "bullmq": "^5.76.9",
    "chrono-node": "^2.9.1",
    "ioredis": "^5.10.1",
    "jsonata": "^2.2.0",
    "libphonenumber-js": "^1.13.6",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.378.0",
    "next": "^14.2.35",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "redis": "^5.12.1",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "stripe": "^22.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsonata": "^1.3.1",
    "@types/node": "^20.12.12",
    "@types/puppeteer": "^5.4.7",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "puppeteer": "^25.0.4",
    "source-map": "^0.7.6",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.22.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.6"
  }
}
