# Enrichment Switcher API Keys
# Copy this file to .env and fill in your credentials

# Serper - Google Maps/Search API
SERPER_API_KEY=your_serper_api_key_here

# Apollo - Firmographic enrichment
APOLLO_API_KEY=your_apollo_api_key_here

# ZoomInfo - Enterprise contact data
ZOOMINFO_CLIENT_ID=your_zoominfo_client_id_here
ZOOMINFO_CLIENT_SECRET=your_zoominfo_client_secret_here

# Yelp - Business data and reviews
YELP_API_KEY=your_yelp_api_key_here
