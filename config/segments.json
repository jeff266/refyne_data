{
  "segments": [
    {
      "id": "smb_local",
      "display_name": "SMB & Local",
      "description": "Search local businesses by industry and location. Ideal for brick-and-mortar prospects.",
      "icon": "storefront",
      "visible": true,
      "order": 1,
      "providers": {
        "cascade": [
          {
            "id": "serper",
            "trigger": "always",
            "trigger_config": {},
            "fields": ["name", "address", "phone", "website", "rating"],
            "timeout_ms": 5000,
            "retry_count": 1
          },
          {
            "id": "apollo",
            "trigger": "on_field_present",
            "trigger_config": { "field": "website" },
            "fields": ["employee_count", "revenue", "industry", "contacts"],
            "timeout_ms": 10000,
            "retry_count": 2
          }
        ],
        "field_priority": "first_wins",
        "dedup_key": "domain"
      },
      "input_fields": [
        {
          "id": "industry",
          "type": "select",
          "label": "Industry",
          "source": "industry_taxonomy",
          "required": true
        },
        {
          "id": "location",
          "type": "text",
          "label": "Location",
          "placeholder": "e.g., Austin, TX or 90210",
          "required": true
        },
        {
          "id": "num_results",
          "type": "slider",
          "label": "Number of results",
          "min": 5,
          "max": 50,
          "default": 20
        }
      ]
    },
    {
      "id": "midmarket",
      "display_name": "Mid-Market",
      "description": "Enrich by company domain or name. Get employee count, industry, revenue, and contacts.",
      "icon": "business",
      "visible": true,
      "order": 2,
      "providers": {
        "cascade": [
          {
            "id": "apollo",
            "trigger": "always",
            "trigger_config": {},
            "fields": ["name", "domain", "employee_count", "revenue", "industry", "contacts"],
            "timeout_ms": 10000,
            "retry_count": 2
          },
          {
            "id": "zoominfo",
            "trigger": "on_missing_field",
            "trigger_config": { "field": "email" },
            "fields": ["email", "direct_dial", "verified_contacts"],
            "timeout_ms": 15000,
            "retry_count": 1
          }
        ],
        "field_priority": "first_wins",
        "dedup_key": "domain"
      },
      "input_fields": [
        {
          "id": "input_type",
          "type": "radio",
          "label": "Search by",
          "options": ["Domain", "Company Name"],
          "default": "Domain",
          "horizontal": true
        },
        {
          "id": "domain",
          "type": "text",
          "label": "Company Domain",
          "placeholder": "e.g., notion.com",
          "show_when": {"input_type": "Domain"}
        },
        {
          "id": "name",
          "type": "text",
          "label": "Company Name",
          "placeholder": "e.g., Notion",
          "show_when": {"input_type": "Company Name"}
        }
      ]
    },
    {
      "id": "enterprise",
      "display_name": "Enterprise",
      "description": "Enterprise-grade enrichment with verified direct dials and emails for key contacts.",
      "icon": "corporate_fare",
      "visible": true,
      "order": 3,
      "providers": {
        "cascade": [
          {
            "id": "zoominfo",
            "trigger": "always",
            "trigger_config": {},
            "fields": ["name", "domain", "employee_count", "revenue", "industry", "contacts", "direct_dial", "verified_email"],
            "timeout_ms": 15000,
            "retry_count": 2
          },
          {
            "id": "apollo",
            "trigger": "on_error",
            "trigger_config": {},
            "fields": ["name", "domain", "employee_count", "revenue", "industry", "contacts"],
            "timeout_ms": 10000,
            "retry_count": 2
          }
        ],
        "field_priority": "first_wins",
        "dedup_key": "domain"
      },
      "input_fields": [
        {
          "id": "domain",
          "type": "text",
          "label": "Company Domain",
          "placeholder": "e.g., salesforce.com",
          "required": true
        }
      ]
    },
    {
      "id": "capability",
      "display_name": "Capability Search",
      "description": "Find companies by what they do. Search by technical capabilities, products, or expertise.",
      "icon": "search",
      "visible": true,
      "order": 4,
      "providers": {
        "cascade": [
          {
            "id": "graphiq",
            "trigger": "always",
            "trigger_config": {},
            "fields": ["name", "domain", "capabilities", "products", "expertise", "industry"],
            "timeout_ms": 12000,
            "retry_count": 2
          },
          {
            "id": "apollo",
            "trigger": "on_missing_field",
            "trigger_config": { "field": "employee_count" },
            "fields": ["employee_count", "revenue", "contacts"],
            "timeout_ms": 10000,
            "retry_count": 2
          }
        ],
        "field_priority": "most_complete",
        "dedup_key": "domain"
      },
      "input_fields": [
        {
          "id": "capabilities",
          "type": "textarea",
          "label": "Capabilities",
          "placeholder": "Enter capabilities separated by commas\ne.g., CNC machining, precision manufacturing, aerospace components",
          "required": true,
          "height": 100
        },
        {
          "id": "num_results",
          "type": "slider",
          "label": "Number of results",
          "min": 5,
          "max": 50,
          "default": 20
        }
      ]
    }
  ],
  "providers": {
    "yelp": {
      "name": "Yelp",
      "type": "local_search",
      "env_key": "YELP_API_KEY",
      "description": "Yelp GraphQL API for local business data, ratings, and reviews"
    },
    "serper": {
      "name": "Serper",
      "type": "local_search",
      "env_key": "SERPER_API_KEY"
    },
    "apollo": {
      "name": "Apollo",
      "type": "enrichment",
      "env_key": "APOLLO_API_KEY"
    },
    "zoominfo": {
      "name": "ZoomInfo",
      "type": "enrichment",
      "env_keys": ["ZOOMINFO_CLIENT_ID", "ZOOMINFO_CLIENT_SECRET"]
    },
    "graphiq": {
      "name": "GraphiqAI",
      "type": "enrichment",
      "env_key": "GRAPHIQ_API_KEY"
    },
    "clay": {
      "name": "Clay",
      "type": "ai_enrichment",
      "description": "Async AI enrichment via Claygent. Requires webhook configuration and calibration.",
      "async": true,
      "requires_calibration": true,
      "env_key": "CLAY_WEBHOOK_URL"
    }
  }
}
