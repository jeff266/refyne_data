# Refyne Search Environment Variables
# Add these to Vercel project settings → Environment Variables

# Serper API Key (Google Search)
# Get from: https://serper.dev/
REFYNE_SERPER_KEY=your_serper_api_key_here

# Jina API Key (Homepage Reader)
# Get from: https://jina.ai/reader
# Fetches full homepage content in parallel with Serper
REFYNE_JINA_KEY=your_jina_api_key_here

# Fireworks API Key (DeepSeek V4 Flash via US-hosted Fireworks.ai)
# Get from: https://fireworks.ai/
# Model: accounts/fireworks/models/deepseek-v4-flash
# Pricing: $0.14/M input, $0.28/M output
REFYNE_FIREWORKS_KEY=your_fireworks_api_key_here

# Anthropic API Key (Claude Haiku fallback)
# Get from: https://console.anthropic.com/
# Model: claude-haiku-4-5-20251001
# Pricing: $0.80/M input, $4/M output
# Used in preview context or when DeepSeek exceeds 5s timeout
REFYNE_ANTHROPIC_KEY=your_anthropic_api_key_here

# Note: These keys are managed centrally by Refyne
# Never expose to clients or add to provider_connections table
# Only needed on Vercel (Next.js runtime), not Railway (worker)
