# Arrangements v2 Preflight Test Suite Environment Variables
# Copy this file to .env.test and fill in your test credentials

# Test user credentials
TEST_ADMIN_EMAIL=admin@test.refynedata.com
TEST_ADMIN_PASSWORD=your-secure-password

TEST_OPERATOR_EMAIL=operator@test.refynedata.com
TEST_OPERATOR_PASSWORD=your-secure-password

TEST_VIEWER_EMAIL=viewer@test.refynedata.com
TEST_VIEWER_PASSWORD=your-secure-password

# Test environment URL (default: https://app.refynedata.com)
TEST_BASE_URL=https://app.refynedata.com

# Browser mode (set to false to run with visible browser for debugging)
HEADLESS=true
